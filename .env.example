# Neo4j (docker-compose.yml)
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
TOROB_DATASET_DIR=/path/to/torob-dataset

# AI provider (OpenAI-compatible)
OPENAI_BASE_URL=https://ai.boxapi.ir/ai/v1
OPENAI_API_KEY=your-key
OPENAI_MODEL=openai/gpt-6.1-sol
OPENAI_REASONING_EFFORT=low

# Backend
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Athena TTS (scripts/athena_tts.py)
ATHENA_ACCESS_TOKEN=
ATHENA_REFRESH_TOKEN=

# Store inquiry (استعلام دستگاه)
VOIP_SERVER=voip.asiatech.ir
VOIP_USER=
VOIP_PASSWORD=
INQUIRY_CALL_OVERRIDE=
NAVATEL_BASE_URL=https://navaphone.com
NAVATEL_API_KEY=
NAVATEL_SRC_PHONE=
NAVATEL_SEND=false
PUBLIC_APP_URL=http://localhost:3000
TTS_PROVIDER=auto

# Postgres (users, sessions, chat history, settings, store insights)
POSTGRES_USER=torob
POSTGRES_PASSWORD=change-me
POSTGRES_DB=torobche
POSTGRES_PORT=5433
